{
 "_readme": [
  "Master list of logger location codes. A code names a PLACE, not a device: when a logger is moved, add a new period",
  "for it with the new code and dates; when a logger is replaced at the same spot, the code stays the same.",
  "Codes are unique within a building (dataset): two buildings can both have BUILDING-INTERIOR-BEDROOM1.",
  "build.py checks this file and writes data/logger_register.csv, which ARC Pattern Lab's register reads.",
  "A logger or period with no code reads as 'location not stated' in Pattern Lab.",
  "Keys beginning with an underscore are notes and are ignored by build.py."
 ],
 "version": 1,
 "grammar": {
  "_note": "Agreed with Andrew Simmonds 20-11-2026: general to particular, capitals and hyphens, optional height token -H<mm> above ground or floor.",
  "types": [
   "WEATHER-STATION",
   "BUILDING-INTERIOR-<room>",
   "BUILDING-EXTERIOR-<position>",
   "BUILDING-ROOFSPACE-<position>",
   "BUILDING-SURFACE-<element>",
   "LANDSCAPE-<feature>-<name>"
  ],
  "landscapeFeatures": [
   "OPEN-GROUND",
   "PAVED",
   "WATER",
   "TREE-CANOPY-LIGHT",
   "TREE-CANOPY-MEDIUM",
   "TREE-CANOPY-DENSE"
  ],
  "status": {
   "confirmed": "stated by Andy's briefing, the Pattern Lab handover or the Pattern Lab register",
   "suggested": "proposed from the logger's name or position; to be confirmed. 'suggested' is not exported as the code",
   "needs-code": "no sensible code yet; position name to agree"
  }
 },
